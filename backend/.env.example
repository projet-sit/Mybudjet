# MYBUDGET Backend — variables d'environnement
# Copie ce fichier en .env et renseigne les valeurs réelles.

PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL (conteneur Docker : mybudget-db)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=mybudget
DB_USER=mybudget
DB_PASSWORD=mybudget_dev_password

# JWT (générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Local uniquement : expose le token de reset dans la réponse API pour les essais.
# Ne jamais définir cette variable sur un environnement partagé ou de production.
EXPOSE_DEV_RESET_TOKEN=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Google Sign-In (optionnel mais recommandé) : client OAuth Web de Google Cloud Console.
# Si défini, le backend vérifie que le idToken est bien destiné à cette application.
GOOGLE_CLIENT_ID=
